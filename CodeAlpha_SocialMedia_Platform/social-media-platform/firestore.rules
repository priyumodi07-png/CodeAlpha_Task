rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Posts Collection
    match /posts/{postId} {
      allow read, write: if true;
      
      // Comments Subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }
      
      // Likes Subcollection
      match /likes/{userId} {
        allow read, write: if true;
      }
    }
    
    // Follows Collection
    match /follows/{followId} {
      allow read, write: if true;
    }
  }
}
